# Destino de despliegue: github-pages | vercel | netlify | other
# - github-pages → base=/Sistematechdepagosmdicos/
# - vercel/netlify/other → base=/
# Déjalos comentados al copiar a .env; actívalos solo para el destino real.
# Ejemplo GitHub Pages:
# VITE_DEPLOY_TARGET=github-pages
# VITE_SITE_URL=https://braval16198.github.io/Sistematechdepagosmdicos

# URL pública del sitio (sin barra final).
# Obligatorio en build para vercel/netlify.
# Opcional en github-pages (usa el default github.io del proyecto).
# El build escribe index.html, robots.txt y sitemap.xml con este origen.
# VITE_SITE_URL=

# Override opcional del base path de Vite (ej. / o /Sistematechdepagosmdicos/)
# VITE_BASE_PATH=/Sistematechdepagosmdicos/

# Nombre visible de la clínica / producto
VITE_APP_NAME=Sistema Tech de Pagos Médicos

# Modo demo: true = autenticación local con usuarios de prueba (sin backend)
VITE_DEMO_MODE=true
